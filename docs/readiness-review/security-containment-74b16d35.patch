+Object.assign(process.env, { VERCEL: '1', VERCEL_URL: 'mk-fraud-platform-abc123-tondanis-projects.vercel.app', VERCEL_BRANCH_URL: 'mk-fraud-platform-git-review-mk-integr-60d093-tondanis-projects.vercel.app', MK_ADMIN_ALLOWED_HOSTS: 'mk-fraud-platform-tondanis-projects.vercel.app' });
