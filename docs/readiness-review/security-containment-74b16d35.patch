+const ADMIN = ['/score/admin', '/score/admin/orders/MKORD-2026-0DE9E75D', '/score/admin/orders/MKORD-2026-0DE9E75D/status', '/score/api/admin/orders/MKORD-2026-0DE9E75D/generate-report', '/score/api/admin/reports/x/download', '/score/api/admin/me', '/score/api/commercial/orders/MKORD-2026-0DE9E75D'];
