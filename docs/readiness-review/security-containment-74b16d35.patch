+const results = [];
+const T = async (id, name, fn) => { try { const [ok, detail] = await fn(); results.push({ id, ok, name, detail }); } catch (e) { results.push({ id, ok: false, name, detail: String(e.stack).split('\n').slice(0, 3).join(' ') }); } };
