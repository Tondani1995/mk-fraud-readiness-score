+  const walk = (d) => { for (const e of fs.readdirSync(d, { withFileTypes: true })) { const p = `${d}/${e.name}`; if (e.isDirectory()) walk(p); else if (/\.(ts|tsx)$/.test(e.name) && /getAdminSession\(|requireAdmin\(|ProtectedAdminPage/.test(fs.readFileSync(p, 'utf8'))) files.push(p); } };
